# ROS build output
build/
install/
log/
# Python and build leftovers
__pycache__/
*.pyc
# Raw bags are large: keep them local, commit only exported CSVs
data/**/bags/
# LaTeX build files
report/**/*.aux
report/**/*.log
report/**/*.out
report/**/*.toc
report/**/*.fls
report/**/*.fdb_latexmk
report/**/*.synctex.gz
# Large video files (upload the final cut, keep only the link in video/README.md)
video/*.mp4
video/*.mov
video/*.mkv
# Editor settings
.vscode/
# Local files (not part of the submission)
submission/
*.egg-info/
.pytest_cache/
# Replay frames (large, regenerated per run)
data/**/frames_*/
